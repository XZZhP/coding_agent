# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 排除，不会入库
# 也可不建 .env，直接设置同名环境变量（二者同时存在时环境变量优先）

# 必填：DeepSeek API 密钥（也可设置环境变量 DEEPSEEK_API_KEY）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 选填：API 地址（OpenAI 兼容网关）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 选填：模型名（默认 deepseek-v4-flash，可改为 deepseek-v4-pro）
DEEPSEEK_MODEL=deepseek-v4-flash
